{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "conversation_id": {
      "type": "string",
      "description": "Sorted emails joined with _ to create unique conversation ID"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "content"
  ]
}