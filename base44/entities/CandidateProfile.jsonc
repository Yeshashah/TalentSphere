{
  "name": "CandidateProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the candidate user"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "portfolio": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "years_of_experience": {
      "type": "number"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "industry": {
      "type": "string"
    },
    "employment_type_preference": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "full_time",
          "contract",
          "remote",
          "freelance"
        ]
      }
    },
    "education_degree": {
      "type": "string"
    },
    "education_university": {
      "type": "string"
    },
    "graduation_year": {
      "type": "number"
    },
    "resume_url": {
      "type": "string"
    },
    "resume_parsed_data": {
      "type": "string"
    },
    "expected_salary": {
      "type": "number"
    },
    "notice_period": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "immediate",
        "2_weeks",
        "1_month",
        "2_months",
        "3_months_plus"
      ]
    },
    "open_to_work": {
      "type": "boolean",
      "default": true
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "companies_only",
        "private"
      ],
      "default": "public"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "full_name"
  ]
}